# Banco (Railway preenche sozinho se você usar ${{Postgres.DATABASE_URL}})
DATABASE_URL=

# Evolution API
EVOLUTION_API_URL=https://sua-evolution.up.railway.app
EVOLUTION_API_KEY=sua-apikey-global
EVOLUTION_INSTANCE=assistente-ia

# Uma senha qualquer, longa. A URL do webhook fica .../webhook/<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=troque-por-uma-senha-longa

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opcionais
DEFAULT_MODE=teste
DEBOUNCE_SECONDS=90
PENDING_HOURS=48
RETENTION_DAYS=90

# Opcional: outros números da equipe Alpha (DDI+DDD), separados por vírgula
EQUIPE_NUMEROS=
